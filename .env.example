# ----------------------------------------------------------------------------
# Puck environment template.
# Copy to `.env` for local development. NEVER commit real values.
# Secrets (tokens, keys) belong in `.secrets` (gitignored) in deployed envs.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# --- Supabase (data backbone: Postgres + Auth + RLS + pgmq/pg_cron) ---
# Local dev values come from `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
# Server-side Supabase URL override for containers (e.g. http://host.docker.internal:54321); optional
SUPABASE_URL_INTERNAL=
SUPABASE_ANON_KEY=replace-with-local-anon-key
# service-role key: server-only. Also required to run the apps/web E2E suite
# (the auth fixture seeds a real session via the admin API). NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# --- Web app (apps/web) ---
# The browser client reads the NEXT_PUBLIC_* pair (same values as above locally).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# OAuth providers — real credentials are needed ONLY for manual login in a
# browser (the E2E suite seeds sessions directly and does not use OAuth).
# Configure these in Supabase Auth settings (or supabase/config.toml) for local.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=

# --- API service (apps/api) ---
API_HOST=0.0.0.0
API_PORT=5200
# Public base URL used when registering the Telegram webhook in production.
PUBLIC_BASE_URL=http://127.0.0.1:5200
# Shared secret for internal/service-to-service endpoints (e.g. event-change
# intake from Janus). Sent as the `x-puck-internal-key` header. Required in
# production — the endpoint fails closed when this is unset.
INTERNAL_API_KEY=replace-with-a-long-random-string

# --- Worker (apps/worker) ---
# How often the worker polls the pgmq queue, in milliseconds.
WORKER_POLL_INTERVAL_MS=2000
# Max delivery attempts before a notification is parked as failed.
WORKER_MAX_ATTEMPTS=5

# --- Telegram channel ---
# `polling` for local dev (no public URL needed); `webhook` for production.
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=replace-with-bot-token-from-botfather
# Random shared secret; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- Email channel ---
# `console` (default, no creds — logs instead of sending) | `resend` | `smtp`
EMAIL_PROVIDER=console
EMAIL_FROM="Puck <noreply@example.com>"
RESEND_API_KEY=
SMTP_URL=
