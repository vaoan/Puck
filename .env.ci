# =============================================================================
# CI environment — Docker app + Docker Supabase, no tunnel
# Topology: ephemeral Supabase on port 54321, app served by the puck-ci
# container at http://localhost:5050. Demo Supabase keys are public constants.
# =============================================================================
TARGET_ENV=ci
NODE_ENV=test

# ─── E2E topology ─────────────────────────────────────────────────────────────
APPS_MODE=docker
SUPABASE_MODE=docker
PUCK_PROD_IMAGE_NAME=puck-ci
PUCK_PROD_CONTAINER_NAME=puck-ci
HOST_PORT=5050
NEXT_PUBLIC_WEB_URL=http://localhost:5050
NEXT_PUBLIC_ENABLE_TEST_IDS=true
NEXT_PUBLIC_BUILD_HASH=ci

# ─── Supabase Docker (local, port 54321) — demo keys (public constants) ───────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_URL=http://localhost:54321
SUPABASE_URL_INTERNAL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
SUPABASE_PORT=54321

# ─── API service ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=5200
PUBLIC_BASE_URL=http://localhost:5200
LOG_LEVEL=warn

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=500
WORKER_MAX_ATTEMPTS=3

# ─── Telegram channel ─────────────────────────────────────────────────────────
# Use webhook in CI — polling is not suitable for automated test runs.
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=$secret:TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=$secret:TELEGRAM_WEBHOOK_SECRET

# ─── Email channel ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=Puck CI <ci@example.com>
RESEND_API_KEY=$secret:RESEND_API_KEY

# ─── OAuth providers ──────────────────────────────────────────────────────────
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=$secret:SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=$secret:SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET
SUPABASE_AUTH_EXTERNAL_REDIRECT_URI=http://localhost:54321/auth/v1/callback
SUPABASE_AUTH_SITE_URL=http://localhost:5200/auth/callback

# ─── Cloudflare tunnels ───────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_ENABLED=false

# ─── Sentry error tracking ────────────────────────────────────────────────────
SENTRY_DSN=$secret:SENTRY_DSN
SENTRY_AUTH_TOKEN=$secret:SENTRY_AUTH_TOKEN
SENTRY_PROJECT=puck
NEXT_PUBLIC_TARGET_ENV=ci
ENV_DEBUG=false
