# =============================================================================
# Dev environment — Supabase Cloud (dedicated non-production project)
# =============================================================================
TARGET_ENV=dev

# ─── Topology ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Supabase Cloud (dev project) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=$secret:DEV_SUPABASE_URL
SUPABASE_URL=$secret:DEV_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=$secret:DEV_SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=$secret:DEV_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=$secret:DEV_SUPABASE_SERVICE_ROLE_KEY

# Not used in cloud mode — kept for env parity with non-cloud environments.
SUPABASE_PORT=N/A
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=

# ─── API service ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=5200
PUBLIC_BASE_URL=http://localhost:5200
LOG_LEVEL=debug

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_ATTEMPTS=5

# ─── Telegram channel ─────────────────────────────────────────────────────────
# Use polling in dev — no public URL required.
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=$secret:TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=$secret:TELEGRAM_WEBHOOK_SECRET

# ─── Email channel ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=Puck Dev <dev@example.com>
RESEND_API_KEY=$secret:RESEND_API_KEY

# ─── OAuth providers ──────────────────────────────────────────────────────────
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=$secret:SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=$secret:SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET
SUPABASE_AUTH_SITE_URL=http://localhost:5200/auth/callback

# ─── Cloudflare tunnels ───────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_ENABLED=false

# ─── Sentry error tracking ────────────────────────────────────────────────────
SENTRY_DSN=$secret:SENTRY_DSN
SENTRY_AUTH_TOKEN=$secret:SENTRY_AUTH_TOKEN
SENTRY_PROJECT=puck
NEXT_PUBLIC_TARGET_ENV=dev
ENV_DEBUG=true
