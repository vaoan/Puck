# =============================================================================
# Secrets template — resolved by scripts/load-env.mjs at runtime
# =============================================================================
# This file documents every secret key Puck needs.
# It is committed as a reference; the real values live in .secrets (gitignored).
#
# To populate .secrets automatically from GitHub repository secrets:
#   pnpm sync-secrets
#
# Or copy and fill manually:
#   cp .secrets.example .secrets
#
# Format: KEY=   (empty value — fill in real values only in .secrets, never here)
# =============================================================================

# ─── Dev — Supabase Cloud (dedicated non-production project) ─────────────────
DEV_SUPABASE_URL=
DEV_SUPABASE_ANON_KEY=
DEV_SUPABASE_SERVICE_ROLE_KEY=

# ─── CI — Supabase Docker (ephemeral, port 54321) ────────────────────────────
CI_SUPABASE_URL=
CI_SUPABASE_ANON_KEY=
CI_SUPABASE_SERVICE_ROLE_KEY=
# JWT signing secret for the CI Supabase stack (HS256, min 32 chars)
# Generate with: openssl rand -base64 32
CI_SUPABASE_JWT_SECRET=
# Postgres superuser password for the CI DB container
# Generate with: openssl rand -base64 24
CI_SUPABASE_DB_PASSWORD=

# ─── Prod — Supabase Cloud (production project) ──────────────────────────────
PROD_SUPABASE_URL=
PROD_SUPABASE_ANON_KEY=
PROD_SUPABASE_SERVICE_ROLE_KEY=

# ─── OAuth providers ─────────────────────────────────────────────────────────
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ─── Telegram channel ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── Email channel (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Cloudflare tunnel ───────────────────────────────────────────────────────
# One-time tunnel token (from: cloudflared tunnel create)
PUCK_CLOUDFLARE_TUNNEL_TOKEN=
# Credentials JSON (for ~/.cloudflared/<tunnel-id>.json)
CLOUDFLARED_TUNNEL_CREDENTIALS=
# Cloudflared config (uses 127.0.0.1 for local dev)
CLOUDFLARED_CONFIG=

# ─── Sentry error tracking ───────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── MCP / developer tooling tokens ─────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=
LINEAR_API_KEY=
VERCEL_TOKEN=
LOGROCKET_API_KEY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
